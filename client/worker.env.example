# 复制为 worker.env 后使用。请勿把真实密钥提交到 Git。
ERP_CONTROL_PLANE_URL=http://127.0.0.1:18789
ERP_WORKER_ID=office-computer-1
ERP_WORKER_TOKEN=<由服务器生成>
ERP_WORKER_ALLOW_SYNTHETIC_DNS=false
ERP_WORKER_OSS_REGION=cn-hangzhou
ERP_WORKER_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ERP_WORKER_OSS_BUCKET=<bucket>
ERP_WORKER_OSS_PUBLIC_BASE_URL=https://example.com
ERP_WORKER_OSS_PREFIX=erp-worker
ERP_WORKER_OSS_ACCESS_KEY_ID=<本机专用RAM用户AccessKey>
ERP_WORKER_OSS_ACCESS_KEY_SECRET=<本机专用RAM用户AccessKey Secret>
ERP_TUNNEL_HOST=203.0.113.10
ERP_TUNNEL_USER=erp-tunnel
ERP_TUNNEL_KEY=C:\Users\Administrator\.ssh\erp_worker_tunnel
ERP_TUNNEL_LOCAL_PORT=18789
ERP_TUNNEL_REMOTE_PORT=8789
