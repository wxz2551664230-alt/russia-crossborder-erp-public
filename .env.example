# local: current all-in-one Windows application
# server: cloud control plane (web/API/database, no heavy local workers)
# worker: local execution client connected to the cloud control plane
ERP_RUNTIME_MODE=local
ERP_ENVIRONMENT=development

ERP_HOST=127.0.0.1
ERP_PORT=8788
ERP_DATA_DIR=./data

# Leave empty in local mode to use data/erp.db. Server mode will use PostgreSQL.
ERP_DATABASE_URL=

# Required on Linux/server deployments. Generate a Fernet key; never commit it.
ERP_SECRET_KEY=

# Server mode requires an operator token separate from Worker credentials.
# Local launcher generates data/operator-access.key and signs the browser in.
ERP_ACCESS_TOKEN=
# Team browser accounts: migrate and initialize the first admin before enabling.
ERP_MULTIUSER_ENABLED=false
# Set true behind the production HTTPS reverse proxy.
ERP_SESSION_COOKIE_SECURE=false
# Additional explicitly trusted asset roots, as a JSON array of paths.
ERP_ASSET_ROOTS=[]
# Exact HTTPS hostnames permitted for OSS read-through (JSON array, no wildcard).
# Configure actual owned bucket/CDN hosts before using cloud-only assets.
ERP_ASSET_REMOTE_ALLOWED_HOSTS=[]
# Optional local proxy Fake-IP compatibility (198.18.0.0/15 only); ignored on server.
ERP_ASSET_ALLOW_SYNTHETIC_DNS=false
# Hard cache cap (1 GiB), per-file cap (128 MiB), disk reserve (512 MiB).
# Only downloaded copies use this cache; originals are never auto-deleted.
ERP_ASSET_CACHE_MAX_BYTES=1073741824
ERP_ASSET_DOWNLOAD_MAX_BYTES=134217728
ERP_ASSET_CACHE_MIN_FREE_BYTES=536870912

# Required later for worker mode.
ERP_CONTROL_PLANE_URL=
ERP_WORKER_ID=
ERP_WORKER_TOKEN=
