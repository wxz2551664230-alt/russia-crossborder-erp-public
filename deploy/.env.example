POSTGRES_DB=erp_staging
POSTGRES_USER=erp_staging
POSTGRES_PASSWORD=<generate-on-server>
ERP_SECRET_KEY=<generate-on-server>
ERP_WORKER_TOKEN=<generate-on-server>

# Required operator credential, distinct from ERP_WORKER_TOKEN
ERP_ACCESS_TOKEN=
# All team members use this server in a browser with their own account.
# Requires migration and bootstrap_admin; no default/shared user password.
ERP_MULTIUSER_ENABLED=true
ERP_SESSION_COOKIE_SECURE=true

# Tasks run on each user's computer, with one credential per execution device.
# Browser accounts and device credentials are separate. A worker client keeps
# ERP_WORKER_TOKEN; the server stores only its SHA-256 hex digest under that ID.
# Empty mappings fail closed when the switch is true, including after revocation.
ERP_WORKER_REQUIRE_DEVICE_IDENTITY=true
ERP_WORKER_TOKEN_HASHES={}
# Exact bucket/CDN HTTPS hosts; no wildcard or URL. Enable only verified hosts.
ERP_ASSET_REMOTE_ALLOWED_HOSTS=[]
ERP_ASSET_CACHE_MAX_BYTES=1073741824
ERP_ASSET_DOWNLOAD_MAX_BYTES=134217728
ERP_ASSET_CACHE_MIN_FREE_BYTES=536870912
